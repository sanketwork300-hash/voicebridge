# Minimal TLS front end for a remote VoiceBridge deployment.
#
#   VOICEBRIDGE_DOMAIN=vb.example.com docker compose --profile gpu --profile tls up
#
# Caddy obtains and renews a certificate automatically. WebSocket upgrades pass
# through reverse_proxy without extra configuration.

{$VOICEBRIDGE_DOMAIN:localhost} {
	encode zstd gzip

	# Long-lived streaming sessions: the default 30s write timeout would cut
	# an idle-but-open translation socket.
	reverse_proxy gateway-gpu:8000 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}
